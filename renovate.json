{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "依存パッケージ・mise.toml のツールの新しい版を PR で届ける（docs/adr/87-dependency-updates.md）。GitHub Actions は Dependabot が扱う（docs/adr/225-actions-lockfile.md）",
  "extends": ["config:recommended", "security:minimumReleaseAgeNpm", ":semanticCommits", ":semanticCommitTypeAll(chore)"],
  "dependencyDashboardTitle": "依存の更新の一覧（Renovate）",
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-8 * * 1"],
  "osvVulnerabilityAlerts": true,
  "commitMessageAction": "",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "を {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}} にする",
  "group": {
    "branchTopic": "{{{groupSlug}}}",
    "commitMessageTopic": "{{{groupName}}}",
    "commitMessageExtra": "",
    "commitMessageSuffix": "を上げる"
  },
  "packageRules": [
    {
      "description": "GitHub Actions は Dependabot が uses: のタグと actions.lock を一緒に上げる（.github/dependabot.yml、docs/adr/225-actions-lockfile.md）。同じ更新の PR が二重に届かないよう、Renovate では扱わない",
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "description": "major 以外はまとめて 1 つの PR にする。major は破壊的な変更を個別に確かめるため、1 つずつの PR にする",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "major 以外の依存",
      "groupSlug": "non-major"
    }
  ]
}
